   "sha256": "6a10142ff836dd8eed6900ffd8e3120749b742205c077717d25b7fd76de38795"
  },
  "tip:lanes": {
   "file": "tip-lanes.mp3",
   "text": "Each stem gets its own lane. Use M to mute it, S to solo it, and the slider to set its level.",
   "seconds": 6.5,
   "sha256": "c785f3eeffc990656dd05a23755a5b6a59588403a6c51b6fd5d7f451323bbfac"
  },
  "tip:fx": {
   "file": "tip-fx.mp3",
   "text": "Click a stem to open its effects. Start from a preset, then switch modules on and off to hear the difference.",
   "seconds": 6.62,
